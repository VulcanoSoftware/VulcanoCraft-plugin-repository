MONGO_ROOT_USERNAME=vulcano_root
MONGO_ROOT_PASSWORD=change-me-strong-mongo-password
MONGO_DB_NAME=vulcanocraft
MONGO_URI=mongodb://vulcano_root:change-me-strong-mongo-password@mongo:27017/vulcanocraft?authSource=admin
MONGO_BACKUP_URI=mongodb://vulcano_root:change-me-strong-mongo-password@mongo:27017/vulcanocraft?authSource=admin

FLASK_SECRET_KEY=change-me-strong-flask-secret-key
ADMIN_DEFAULT_PASSWORD=admin123

CURSEFORGE_API_KEY=change-me-curseforge-api-key

# Optioneel maar sterk aanbevolen: een GitHub token (geen enkele scope nodig) verhoogt de
# API-limiet van 60 naar 5000 requests/uur. Zonder token falen de GitHub-fetches tijdens een
# cron-cyclus met veel plugins al snel. Maak er een aan op https://github.com/settings/tokens
GITHUB_TOKEN=

ENABLE_BACKUPS=false
BACKUP_INTERVAL_HOURS=24

